{# @pebvariable name="server" type="smithereen.model.Server" #}
{% extends "page" %}
{% block content %}
<div class="singleColumn">
	<h2>{{ server.host }}</h2>
	{% if not mobile %}
	<h3 class="marginBefore">{{ L('statistics') }}</h3>
	<div class="marginBefore" id="serverStatsGraph" data-graph-data="{{ graphData }}"></div>
	{% script %}renderGraph("serverStatsGraph");{% endscript %}
	{% endif %}
	<h3 class="marginBefore">{{ L('server_restrictions') }}</h3>
	<div class="marginBefore">
		{% if restriction is null %}
		{{ L('server_restrictions_none') }}
		{% else %}
		<div>{{ L('server_restrictions_suspended') }}</div>
		{% if restriction.domain!=server.host %}
		<div>{{ L('server_restrictions_suspended_higher_level_domain', {'domain': restriction.domain}) }}</div>
		{% endif %}
		<div class="marginBefore"><b><a href="{{ profileURL(restriction.moderatorId) }}">{{ users[restriction.moderatorId] | name('full') }}</a> {{ LD(restriction.createdAt) }}</b>{% if restriction.privateComment is not null %}: {{ restriction.privateComment }}{% endif %}</div>
		{% endif %}
	</div>
	<div class="marginBefore">
		{% if restriction is null %}
		<a class="button" href="/settings/admin/federationRules/create?domain={{ server.host | urlencode }}" data-ajax-box>{{ L('admin_federation_restrict_server') }}</a>
		{% else %}
		<a class="button" href="/settings/admin/federationRules/{{ restriction.domain }}/edit" data-ajax-box>{{ L('admin_federation_edit_rule') }}</a>
		<a class="button" href="/settings/admin/federationRules/{{ restriction.domain }}/confirmDelete" data-confirm-title="{{ L('admin_federation_delete_rule') }}" data-confirm-message="{{ L('admin_federation_delete_rule_confirm', {'domain': restriction.domain}) | forceEscape }}" data-confirm-action="/settings/admin/federationRules/{{ restriction.domain }}/delete">{{ L('admin_federation_delete_server_rule') }}</a>
		{% endif %}
	</div>
	<h3 class="marginBefore">{{ L('server_availability') }}</h3>
	<div class="marginBefore">{{ L('server_availability_explain') }}</div>
	<div class="marginBefore forceLineHeight">
		{% if server.availability=='UP' %}
		✅ {{ L('server_availability_up') }}
		{% elseif server.availability=='FAILING' %}
		⚠️ {{ L('server_availability_failing', {'days': 7-server.errorDayCount, 'lastErrorDate': LD(server.lastErrorDay)}) }}
		{% else %}
		🚫 {{ L('server_availability_down') }}
		<a href="/settings/admin/federation/{{ server.host }}/resetAvailability?csrf={{ csrf }}" data-ajax-box>{{ L('server_reset_availability') }}</a>
		{% endif %}
	</div>
</div>
{% if not mobile %}{{ addScriptFile('graph.js') }}{% endif %}
{% endblock %}
