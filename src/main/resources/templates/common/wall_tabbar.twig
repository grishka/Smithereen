{# @pebvariable name="owner" type="smithereen.model.User" #}
{# @pebvariable name="otherUser" type="smithereen.model.User" #}
{# @pebvariable name="isGroup" type="boolean" #}
{# @pebvariable name="tab" type="String" #}
<div class="tabbar">
	{% if canSeeOthersPosts and (owner.hasWall or isGroup) %}
	<a href="{% if isSearch %}{{ addQueryParams(url, {'own': null}) }}{% else %}{{ owner.typeAndIdForURL }}/wall{% endif %}" class="{%if tab=="all"%}selected{%endif%}">{{ L(isGroup ? 'wall_of_group' : 'wall_all_posts') }}</a>
	{% endif %}
	{% if not isGroup %}
	<a href="{% if isSearch %}{{ addQueryParams(url, {'own': '1'}) }}{% else %}{{ owner.typeAndIdForURL }}/wall/own{% endif %}" class="{%if tab=="own"%}selected{%endif%}">{{ owner==currentUser ? L('wall_my_posts') : L('wall_posts_of_X', {'name': owner.firstAndGender}) }}</a>
	{% endif %}
	{% if tab=="single" %}
	    <a href="#" class="selected">{{ L('wall_post_title') }}</a>
	{% elseif tab=="wall2wall" %}
		<a href="#" class="selected">{{ L('wall_X_and_Y', {'name1': owner | name('first'), 'name2': otherUser | name('first')}) }}</a>
	{% endif %}
	{% if currentUser is not null and not isMobile %}
		<div class="aux">
			{% if search %}
			<a href="{{ owner.typeAndIdForURL }}/wall">{{ L('wall_back_to_all_posts') }}</a>
			{% else %}
			<a href="{{ owner.typeAndIdForURL }}/wall/search">{{ L('wall_go_to_search') }}</a>
			{% endif %}
		</div>
	{% endif %}
</div>